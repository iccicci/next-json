{
  "author": "Daniele Ricci <daniele.icc@gmail.com> (https://github.com/iccicci)",
  "bugs": "https://github.com/iccicci/next-json/issues",
  "contributors": [
    "Daniele Ricci <daniele.icc@gmail.com> (https://github.com/iccicci)"
  ],
  "description": "Next JavaScript Object Notation",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "npm-check-updates": "23.1.1",
    "peggy": "^5.1.1",
    "prettier": "^3.10.1",
    "ts-pegjs": "^4.2.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=14.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "funding": {
    "url": "https://github.com/iccicci/next-json#donating"
  },
  "homepage": "https://github.com/iccicci/next-json#readme",
  "keywords": [
    "bigint",
    "buffer",
    "circular",
    "circular-reference",
    "custom-json",
    "date",
    "deserialize",
    "eval",
    "extended-json",
    "infinity",
    "javascript",
    "json",
    "map",
    "nan",
    "parse",
    "regexp",
    "repeated",
    "repeated-reference",
    "serialize",
    "set",
    "stringify",
    "undefined"
  ],
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "name": "next-json",
  "prettier": {
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "jsxBracketSameLine": true,
    "printWidth": 200,
    "trailingComma": "none",
    "useTabs": false
  },
  "readmeFilename": "README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iccicci/next-json.git"
  },
  "scripts": {
    "all": "yarn coverage && yarn eslint && yarn build",
    "build": "make build",
    "coverage": "TZ=Europe/Rome vitest run --coverage",
    "deploy": "make deploy",
    "deps": "npm-check-updates -t minor -u && yarn && npm-check-updates -t latest",
    "eslint": "eslint",
    "parser": "typescript",
    "precoverage": "make",
    "pretest": "make",
    "test": "TZ=Europe/Rome vitest run"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "version": "0.5.3"
}
