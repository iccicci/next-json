{
  "author": "Daniele Ricci <daniele.icc@gmail.com> (https://github.com/iccicci)",
  "bugs": "https://github.com/iccicci/next-json/issues",
  "contributors": [
    "Daniele Ricci <daniele.icc@gmail.com> (https://github.com/iccicci)"
  ],
  "description": "Next JavaScript Object Notation",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.14",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-keys": "^2.3.5",
    "express": "^5.2.0",
    "peggy": "^5.0.6",
    "prettier": "^3.7.3",
    "ts-pegjs": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14",
    "yarn-upgrade-all": "^0.7.5"
  },
  "engines": {
    "node": ">=14.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "funding": {
    "url": "https://github.com/iccicci/next-json#donating"
  },
  "homepage": "https://github.com/iccicci/next-json#readme",
  "keywords": [
    "bigint",
    "buffer",
    "circular",
    "circular-reference",
    "custom-json",
    "date",
    "deserialize",
    "eval",
    "extended-json",
    "infinity",
    "javascript",
    "json",
    "map",
    "nan",
    "parse",
    "regexp",
    "repeated",
    "repeated-reference",
    "serialize",
    "set",
    "stringify",
    "undefined"
  ],
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "name": "next-json",
  "prettier": {
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "jsxBracketSameLine": true,
    "printWidth": 200,
    "trailingComma": "none",
    "useTabs": false
  },
  "readmeFilename": "README.md",
  "repository": "https://github.com/iccicci/next-json",
  "scripts": {
    "build": "make build",
    "coverage": "TZ=Europe/Rome vitest run --coverage",
    "deploy": "make deploy",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "packages": "yarn-upgrade-all --ignore-workspace-root-check",
    "parser": "typescript",
    "precoverage": "make",
    "pretest": "make",
    "test": "TZ=Europe/Rome vitest run"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "version": "0.5.1"
}
